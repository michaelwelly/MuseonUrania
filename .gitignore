.DS_Store
.env
.env.*
# Образцы без значений — это документация, а не секреты. Исключение именное,
# а не «!.env.*.example»: правило с двумя звёздочками однажды пропустит
# .env.prod.example, который кто-то заполнил по-настоящему.
!.env.example
!.env.host.example

# Local agent/session artifacts
.codex/
.codex_audio_chunks/
.codex_frames/
.codex_transcripts/
.codex_whisper_chunks/
.codex_whisper_out/
.codex_tmp_*

# Build/runtime artifacts
target/
dist/
build/
node_modules/
.next/
coverage/

# Presentation generator diagnostics and superseded drafts
outputs/*.inspect.ndjson
outputs/*_v0.*
outputs/*_v1_*
outputs/*_v2_*
tmp/
output/
outputs/**/tmp*/
outputs/**/rendered_*/
outputs/**/owner_deck_tmp/

# IDE
.idea/
.vscode/
*.iml

# Генерируется тулингом, в репозиторий не идёт
AGENTS.md
AGENTS.en.md
CLAUDE.md
CLAUDE.en.md
next-env.d.ts

# Временные файлы Office, живут пока документ открыт
~$*

# Сборка страницы с вариантами типографики. Шаблон и скрипт в репозитории,
# результат весит мегабайт вшитыми шрифтами и пересобирается за секунду:
#   node outputs/typography_variants/build.mjs
outputs/typography_variants/typography_variants.html
outputs/typography_variants/Onest.ttf
