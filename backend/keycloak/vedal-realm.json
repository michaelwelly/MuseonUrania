{
  "realm": "vedal",
  "enabled": true,
  "displayName": "VEDAL Portal",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "portal-admin",
        "description": "Всё без ограничений: содержимое сайта, закрытый контур продаж, журнал, справочник сотрудников и уничтожение персональных данных."
      },
      {
        "name": "portal-sales",
        "description": "Закрытый контур продаж: заявки, клиенты, сделки, КП, разговоры и аналитика. Содержимое сайта не правит."
      },
      {
        "name": "portal-production",
        "description": "Содержимое сайта: продукция, категории, новости, документы и снимки. Клиентскую базу не видит."
      }
    ]
  },
  "clients": [
    {
      "clientId": "vedal-admin-ui",
      "name": "Админка VEDAL Portal",
      "description": "Публичный клиент админки на Next.js. Секрета нет и быть не может: код клиента выполняется в браузере. Поток защищается PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8080",
        "http://127.0.0.1:8080",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "vedal-portal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vedal-portal",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "vedal-portal",
      "name": "VEDAL Portal (сервер)",
      "description": "Портал токены не выдаёт — он их проверяет. Клиент заведён затем, чтобы его имя можно было положить в aud выданного токена.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "vedal-portal-svc",
      "name": "VEDAL Portal (служебная учётная запись)",
      "description": "Портал ходит этим клиентом в административное API Keycloak за списком сотрудников. Право ровно одно — view-users.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "vedal-portal-svc-local"
    }
  ],
  "users": [
    {
      "username": "editor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Локальный",
      "lastName": "редактор",
      "email": "editor@vedal.local",
      "credentials": [
        {
          "type": "password",
          "value": "editor-local",
          "temporary": false
        }
      ],
      "realmRoles": [
        "portal-admin"
      ]
    },
    {
      "username": "sales",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Локальный",
      "lastName": "продавец",
      "email": "sales@vedal.local",
      "credentials": [
        {
          "type": "password",
          "value": "sales-local",
          "temporary": false
        }
      ],
      "realmRoles": [
        "portal-sales"
      ]
    },
    {
      "username": "production",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Локальный",
      "lastName": "редактор сайта",
      "email": "production@vedal.local",
      "credentials": [
        {
          "type": "password",
          "value": "production-local",
          "temporary": false
        }
      ],
      "realmRoles": [
        "portal-production"
      ]
    },
    {
      "username": "service-account-vedal-portal-svc",
      "enabled": true,
      "serviceAccountClientId": "vedal-portal-svc",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    }
  ]
}
