# Настройки для машины с соседом. Копируется на сервер в backend/.env
# и заполняется случайными паролями — значений по умолчанию у секретов
# в compose.host.yaml нет, и без них стек не поднимется. Это сделано нарочно:
# сервер, молча вставший с паролем «vedal», хуже сервера, который не встал.
#
# Пароли не придумывать руками:
#   openssl rand -base64 24
#
# Файл в репозиторий не попадает — он в .gitignore.

# ————— база —————
# Ролей две. VEDAL_DB_USER — владелец схемы, под ним ходит Flyway и Debezium.
# VEDAL_RUNTIME_USER — под ним работает приложение: данные менять может,
# схему, права и журнал — нет (миграции V15 и V16).
VEDAL_DB_NAME=vedal
VEDAL_DB_USER=vedal
VEDAL_DB_PASSWORD=

VEDAL_RUNTIME_USER=vedal_app
VEDAL_RUNTIME_PASSWORD=

# ————— объектное хранилище —————
VEDAL_S3_ACCESS_KEY=vedal
VEDAL_S3_SECRET_KEY=

# ————— Keycloak —————
# Учётная запись администратора самого Keycloak, не портала.
VEDAL_KEYCLOAK_ADMIN=admin
VEDAL_KEYCLOAK_ADMIN_PASSWORD=

# Секрет служебного клиента: им портал ходит в административное API Keycloak
# за списком сотрудников. В realm машины разработчика лежит значение по
# умолчанию; здесь оно задаётся своим.
VEDAL_OIDC_SVC_CLIENT_SECRET=

# ————— адреса —————
#
# ВНИМАНИЕ: это адреса, которые видит БРАУЗЕР, то есть локальные концы
# SSH-туннеля, а не порты на сервере. Адрес Keycloak попадает в поле `iss`
# токена и сверяется буквально, а realm разрешает возврат после входа только
# на localhost:8080 — значит, у браузера должны быть именно эти адреса.
VEDAL_PUBLIC_URL=http://localhost:8080
VEDAL_KEYCLOAK_URL=http://localhost:8180
VEDAL_MEDIA_URL=http://localhost:8080/media

VEDAL_ALLOWED_ORIGINS=http://localhost:8080
VEDAL_ADMIN_ORIGINS=http://localhost:8080

# ————— порты на самом сервере —————
#
# Слушаются только на 127.0.0.1. Менять, если заняты соседом: проверить
#   sudo ss -ltnp | grep -E ':(18080|18180)\b'
VEDAL_GATEWAY_HOST_PORT=18080
VEDAL_KEYCLOAK_HOST_PORT=18180

# ————— почта —————
# Пусто — уведомления менеджеру не отправляются. Чужую почту не подставляем.
VEDAL_NOTIFICATIONS_MANAGER=
