nNewsRow"}}}},"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Все материалы, включая черновики","tags":["Админка: новости"]},"post":{"description":"Создаётся черновиком.","operationId":"create_1","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminNewsForm"}}},"required":true},"responses":{"200":{"content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminNews"}}},"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Завести материал","tags":["Админка: новости"]}},"/api/admin/v1/news/tags":{"get":{"description":"Закрытый список из проверки в схеме. Админка рисует по нему выбор, а не свободное поле.","operationId":"tags","responses":{"200":{"content":{"*/*":{"schema":{"type":"array","items":{"type":"string"}}}},"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Рубрики","tags":["Админка: новости"]}},"/api/admin/v1/news/{id}":{"delete":{"description":"Опубликованный материал сначала снимается с публикации: живая ссылка из рассылки не должна переставать открываться одним нажатием.","operationId":"delete","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Удалить материал","tags":["Админка: новости"]},"get":{"operationId":"item","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminNews"}}},"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Материал целиком","tags":["Админка: новости"]},"put":{"operationId":"update_1","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminNewsForm"}}},"required":true},"responses":{"200":{"content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminNews"}}},"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Правка материала","tags":["Админка: новости"]}},"/api/admin/v1/news/{id}/publish":{"post":{"description":"Без даты в ленте публикация отклоняется — это ограничение схемы news_published_needs_date.","operationId":"publish_1","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminNews"}}},"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Опубликовать материал","tags":["Админка: новости"]}},"/api/admin/v1/news/{id}/unpublish":{"post":{"operationId":"unpublish_1","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminNews"}}},"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Снять материал с публикации","tags":["Админка: новости"]}},"/api/admin/v1/products":{"get":{"operationId":"products","responses":{"200":{"content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AdminProductRow"}}}},"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Все изделия, включая неопубликованные","tags":["Админка: каталог"]},"post":{"description":"Создаётся неопубликованным. Публикация — отдельным действием.","operationId":"create","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminProductForm"}}},"required":true},"responses":{"200":{"content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminProduct"}}},"description":"OK"}},"security":[{"keycloak":[]}],"summary":"Завести изделие","tags":["Админка: каталог"]}},"/api/admin/v1/products/{id}":{"get":{"operationId":"product","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"content":{"*/*":{"schema":{"$ref":"#/components/schemas/AdminProduct"}}},"description":"OK"}},"security":[{"keycloa