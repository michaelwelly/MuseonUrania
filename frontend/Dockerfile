# Образ сайта.
#
# Одна особенность, из-за которой он устроен не как обычный образ Next:
# каталог, новости и документы фронтенд забирает из публичного API
# НА СБОРКЕ и уезжает в статику. Это свойство №1 из спеки — падение
# бэкенда не роняет сайт, — и оно же означает, что `npm run build`
# требует живого портала.
#
# Поэтому сборка страниц вынесена в запуск контейнера, а не в сборку
# образа: во время `docker build` портала нет, а собранный без него образ
# унёс бы в статику содержимое content/*.ts вместо базы и врал бы молча.
# Compose поднимает контейнер после того, как портал ответил healthcheck'у.

FROM node:24-alpine AS deps
WORKDIR /app

# Слой зависимостей отдельно от исходников: правка страницы не должна
# тянуть повторную установку пакетов.
COPY package.json package-lock.json ./
RUN npm ci

FROM node:24-alpine AS runtime
WORKDIR /app

# curl для healthcheck'а в compose.
RUN apk add --no-cache curl

# Владелец проставляется при копировании, а не отдельным `chown -R`:
# тот обходит несколько десятков тысяч файлов в node_modules и стоит
# минуту на каждой сборке, ничего не давая взамен.
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .

# Next пишет в .next при сборке, поэтому каталог должен принадлежать
# пользователю, под которым идёт запуск.
#
# Сам /app создал WORKDIR от имени root, а `COPY --chown` ставит владельца
# только на копируемое — каталог остаётся root'овым. Под `node` первая же
# сборка падает на `mkdir /app/.next`, причём не при сборке образа,
# а при запуске контейнера: сайт отвечает пятисотой, образ при этом
# собрался «успешно». Здесь chown ровно одного каталога — это не обход
# node_modules, ради которого убрали `chown -R`, и стоит он нисколько.
RUN chown node:node /app
USER node

EXPOSE 3000

# Сборка на старте, потом запуск. Портал к этому моменту уже здоров —
# за этим следит depends_on в compose.
CMD ["sh", "-c", "npm run build && npm run start"]
