# Адрес публичного API бэкенда. Скопировать в .env.local и поправить под себя.
#
# Не задан — каталог, новости и документы берутся из content/*.ts, формы и
# Ведалина честно говорят, что отправка не подключена. Это рабочий режим вёрстки:
# фронтенд поднимается без Docker, базы и серверной части.
#
# Задан — источником становится бэкенд. Если он не ответит, сборка упадёт:
# тихо подставить захардкоженный каталог опаснее, чем не собраться.
#
# Бэкенд должен разрешить источник сайта в CORS — переменная
# VEDAL_ALLOWED_ORIGINS на его стороне.
NEXT_PUBLIC_API_URL=http://localhost:8081

# Адрес API для СБОРКИ, если он отличается от браузерного. Задавать нужно
# ровно в одном случае — когда сайт работает в контейнере: `localhost:8080`
# изнутри контейнера ведёт в сам контейнер, а `portal:8081` из браузера
# не резолвится, и один адрес на оба случая невозможен.
#
# Без префикса NEXT_PUBLIC_ намеренно: внутреннее имя хоста не должно уехать
# в клиентский бандл. Не задан — сборка берёт NEXT_PUBLIC_API_URL.
# VEDAL_API_INTERNAL_URL=http://portal:8081

# Вход в админку (/admin). Пароли и второй фактор живут в Keycloak, портал
# только проверяет выданный токен.
#
# Не задан — раздел /admin честно говорит, что не настроен, и никуда не ходит.
# Публичный сайт от этого не зависит.
#
# Адрес обязан совпадать с тем, что портал видит в поле iss токена: его
# он сверяет буквально. В локальном стеке Keycloak поднимается на 8180.
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8180/realms/vedal
NEXT_PUBLIC_OIDC_CLIENT_ID=vedal-admin-ui

# Откуда брать фотографии. Не задан — файлы отдаются из frontend/public, как
# раньше. Задан — из объектного хранилища: локально это MinIO из
# backend/compose.yaml, в облаке будет Yandex Object Storage.
#
# В контенте и в базе лежит путь вида /photos/products/vedal-r1-r2.jpg,
# а хост подставляется отсюда: имя хоста — свойство окружения, и в данных ему
# не место, иначе смена бакета превращается в миграцию.
#
# Поднять хранилище и залить снимки:
#   docker compose -f backend/compose.yaml up -d minio minio-init
#   node backend/tools/upload-media.mjs
# Адрес бакета с фотографиями. Хранилище одно и настоящее — MinIO из стека
# убран, локального адреса больше не существует.
#
# Пусто — сайт берёт снимки из frontend/public/photos, как лежат
# в репозитории. Это рабочий режим вёрстки: картинки на месте без Docker,
# без ключей и без сети.
NEXT_PUBLIC_MEDIA_URL=https://storage.yandexcloud.net/vedal-media
