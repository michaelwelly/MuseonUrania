[Unit]
Description=VEDAL: проверять main каждые две минуты

[Timer]
# Две минуты — компромисс. Реже: правка едет на стенд дольше, чем человек
# успевает переключиться на вкладку и обновить страницу. Чаще: смысла нет,
# сама сборка идёт минуты, и лишние проверки только шумят в журнале.
OnBootSec=2min
OnUnitActiveSec=2min

# Разброс, чтобы проверки не приходились ровно на круглые минуты вместе
# с остальными таймерами машины.
RandomizedDelaySec=20s

# Пропущенные запуски (машина была выключена) не копятся: догонять нечего,
# важен только текущий хеш main.
Persistent=false

[Install]
WantedBy=timers.target
