[Unit]
Description=VEDAL: снимать копию базы каждую ночь

[Timer]
# Три часа ночи по времени машины (UTC): в это время в портале никого,
# и дамп не соперничает с работой за диск.
OnCalendar=*-*-* 03:00:00

# Разброс, чтобы копия не начиналась ровно в ту же секунду, что и чужие
# ночные задания на этой же машине — она не одна.
RandomizedDelaySec=10min

# Машина была выключена в три ночи — копия снимется при первом запуске,
# а не пропустится до следующей ночи. Для резерва пропущенный день дороже
# лишней нагрузки утром.
Persistent=true

[Install]
WantedBy=timers.target
