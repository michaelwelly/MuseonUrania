[Unit]
Description=VEDAL: проверять стенд каждые пять минут

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min

# Пять минут — компромисс между «узнать быстро» и «не устроить себе фон».
# Тревога поднимается на переходе состояния, поэтому частая проверка не
# означает частых оповещений.
RandomizedDelaySec=30s

# Догонять пропущенное незачем: важно текущее состояние, а не история
# за то время, пока машина была выключена.
Persistent=false

[Install]
WantedBy=timers.target
